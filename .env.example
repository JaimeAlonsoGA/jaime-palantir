# Password for the owner API: every /api request except GET /api/v1 needs Authorization: Bearer <this>.
# Without it the API is off (503). Generate one with: openssl rand -hex 32
PORTFOLIO_API_TOKEN=replace-with-a-long-random-secret

# Production only (set in Vercel): writes become commits to this repo and Vercel deploys them.
# A fine-grained GitHub token limited to this repository, with Contents: read and write.
# Leave both out locally and the API writes to disk.
# PORTFOLIO_GITHUB_TOKEN=github_pat_...
# PORTFOLIO_GITHUB_REPO=JaimeAlonsoGA/jaimealonso
